// Business models are added incrementally as each PRD.md slice is
// implemented (see GitHub issues #2 onward).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma requires at least one model to generate a client. This one exists
// solely so the deploy pipeline (issue #1) has a real migration to run
// and a query to prove connectivity to the dedicated app database — it is
// not a business entity from PRD.md.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  // AES-256-GCM ciphertext (see lib/crypto.ts), never the raw key. Null
  // means this user has no key of their own and AI requests fall back to
  // the workspace-wide GEMINI_API_KEY env var (see lib/user-gemini-key.ts).
  geminiApiKeyEncrypted String?
  // Whether this user has dismissed/finished the onboarding wizard at least
  // once. Re-openable anytime from the nav bar regardless of this flag.
  hasSeenOnboarding Boolean       @default(false)
  episodeRoles EpisodeRole[]
  projectRoles ProjectRole[]
  createdAt    DateTime      @default(now())
}

enum WorkspaceMode {
  SOLO
  TIM
}

// Singleton row (id is always 1) — this app has exactly one workspace,
// not multiple tenants, per PRD.md Out of Scope.
model WorkspaceSettings {
  id        Int           @id @default(1)
  mode      WorkspaceMode @default(SOLO)
  updatedAt DateTime      @updatedAt
}

enum ThemeIdeaStatus {
  RAW
  SELECTED
}

model ThemeIdea {
  id          String          @id @default(cuid())
  title       String
  description String?
  tags        String[]        @default([])
  status      ThemeIdeaStatus @default(RAW)
  episodeId   String?         @unique
  episode     Episode?        @relation(fields: [episodeId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum EpisodeStage {
  BANK_TEMA
  RISET_OUTLINE
  PRA_PRODUKSI
  PANDUAN_EKSEKUSI
  PASCA_PRODUKSI
  PUBLISH_DISTRIBUSI
  EVALUASI
}

model Episode {
  id                   String            @id @default(cuid())
  title                String
  stage                EpisodeStage      @default(BANK_TEMA)
  recordingScheduledAt DateTime?
  hostId               String?
  host                 Host?             @relation(fields: [hostId], references: [id], onDelete: SetNull)
  // Which rundown segment Mode Eksekusi is currently showing, and when it
  // started — persisted (not just client-side React state) so a companion
  // display (TV/tablet/phone via TvPairing) can poll and stay in sync.
  activeSegmentId       String?
  activeSegment         RundownSegment?   @relation("EpisodeActiveSegment", fields: [activeSegmentId], references: [id], onDelete: SetNull)
  activeSegmentStartedAt DateTime?
  themeIdea            ThemeIdea?
  outlineItems         OutlineItem[]
  guestQuestions       GuestQuestion[]
  checklistItems       ChecklistItem[]
  guests               Guest[]
  rundownSegments      RundownSegment[]
  timestampMarkers     TimestampMarker[]
  evaluationNotes      EvaluationNote[]
  hostEvaluations      HostEvaluation[]
  roles                EpisodeRole[]
  tvPairings           TvPairing[]
  showNotesDraft       String?
  showNotesExternalUrl String?
  publishTitle         String?
  publishDescription   String?
  publishTags          String[]          @default([])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// A reusable roster of hosts/moderators (unlike Guest, which is per-episode
// and one-off) — the same host typically runs many episodes, so the team
// references their bio/contact during Pra-Produksi instead of re-entering
// it each time. Deliberately just informational (name/contact/bio), not
// linked to Gemini prompts — see the per-user Gemini key feature for that
// kind of AI-facing personalization instead.
model Host {
  id          String           @id @default(cuid())
  name        String
  contact     String?
  bio         String?
  episodes    Episode[]
  evaluations HostEvaluation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Distinct from EvaluationNote: EvaluationNote is about the episode/topic
// itself (and can become a new Bank Tema idea), while this is specifically
// about how the assigned host performed on a given episode.
model HostEvaluation {
  id        String   @id @default(cuid())
  hostId    String
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model OutlineItem {
  id           String   @id @default(cuid())
  episodeId    String
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content      String
  referenceUrl String?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuestQuestion {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimestampMarker {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  label     String
  timeLabel String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvaluationNote {
  id                     String    @id @default(cuid())
  episodeId              String
  episode                Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content                String
  convertedToThemeIdeaAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// Shared by Pra-Produksi, Pasca-Produksi, and Publish & Distribusi checklists
// (distinguished by `category`) per PRD.md Implementation Decisions — one
// reusable model instead of three near-identical tables.
enum ChecklistCategory {
  PRE_PRODUCTION
  POST_PRODUCTION
  PUBLISH
}

model ChecklistItem {
  id        String            @id @default(cuid())
  episodeId String
  episode   Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  category  ChecklistCategory
  label     String
  isDone    Boolean           @default(false)
  order     Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Guest {
  id            String   @id @default(cuid())
  episodeId     String
  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  name          String
  contact       String?
  briefingNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Distinct from OutlineItem: OutlineItem is research/prep material,
// RundownSegment is what actually renders in the full-screen execution
// view (issue #10/#11) — per PRD.md Implementation Decisions, these are
// deliberately separate models even though both are "ordered content
// per episode".
model RundownSegment {
  id               String   @id @default(cuid())
  episodeId        String
  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title            String
  talkingPoints    String
  estimatedMinutes Int      @default(5)
  order            Int
  // Ad-hoc note jotted during a live execution session (e.g. "perlu take
  // ulang di segmen 3") — distinct from talkingPoints, which is prep
  // content authored beforehand.
  sessionNote      String?
  activeInEpisodes Episode[] @relation("EpisodeActiveSegment")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Short-lived pairing code so a companion display (Smart TV app, or a
// tablet/phone browser) can read live Mode Eksekusi state without a full
// NextAuth login — see the Flutter companion-app spec, Milestone 0. Once
// activated by a first successful read, a code no longer expires (until
// the episode itself is deleted) so the display can reconnect after a
// restart without re-pairing.
model TvPairing {
  id          String    @id @default(cuid())
  code        String    @unique
  episodeId   String
  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Restructured from the original {PRODUCER, HOST, EDITOR} to mirror the
// actual production hierarchy: an overall lead plus one role per phase of
// the workflow (ideation, live recording, post/evaluation).
enum EpisodeRoleType {
  LEADER_PRODUKSI
  TIM_BRAINSTORMING
  TIM_LIVE
  TIM_EVALUASI
}

// Only meaningful in Tim mode (see WorkspaceSettings). A user can hold more
// than one role on the same episode (e.g. Leader Produksi AND Tim Live).
model EpisodeRole {
  id        String          @id @default(cuid())
  episodeId String
  episode   Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      EpisodeRoleType
  createdAt DateTime        @default(now())

  @@unique([episodeId, userId, role])
}

// --- Video production (Yassalam Media Studio) ---
//
// Project is the video-production counterpart to Episode (podcast).
// Deliberately a fully separate model, not a variant of Episode: video
// workflow needs different stages, a visual storyboard, multi-day shoots,
// and a staged edit-approval pipeline (Rough Cut -> Fine Cut -> Picture
// Lock) that Episode has no equivalent for. Coexists with Episode in the
// same app/database, sharing only User and WorkspaceSettings — no
// relation to Episode/EpisodeStage/EpisodeRoleType anywhere below.
enum ProjectStage {
  IDE
  PRA_PRODUKSI
  PRODUKSI
  PASCA_PRODUKSI
  DISTRIBUSI
}

model Project {
  id                String            @id @default(cuid())
  title             String
  stage             ProjectStage      @default(IDE)
  roles             ProjectRole[]
  scriptBreakdowns  ScriptBreakdown[]
  storyboardFrames  StoryboardFrame[]
  shotListItems     ShotListItem[]
  shootingDays      ShootingDay[]
  editVersions      EditVersion[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Mirrors EpisodeRoleType's shape but kept as its own enum — a video
// project and a podcast episode have distinct role vocabularies.
enum ProjectRoleType {
  LEADER_PRODUKSI_VIDEO
  TIM_PRA_PRODUKSI
  TIM_PRODUKSI
  TIM_PASCA_PRODUKSI
}

// Only meaningful in Tim mode (see WorkspaceSettings, shared with
// EpisodeRole). A user can hold more than one role on the same project.
model ProjectRole {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRoleType
  createdAt DateTime        @default(now())

  @@unique([projectId, userId, role])
}

// Pre-production, per scene: what a scene needs (location, props, cast) so
// the team can plan logistics/budget/casting from it — distinct from
// StoryboardFrame (visual framing) and ShotListItem (technical camera
// setup), which are deliberately separate models even though all three are
// "ordered content per Project", mirroring how the research behind this
// system found each is typically authored by a different person.
model ScriptBreakdown {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location  String
  props     String?
  cast      String?
  notes     String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One frame per shot. Per the system plan's file-storage decision, this
// never stores an uploaded image — just a link to one already uploaded to
// Google Drive by the team.
model StoryboardFrame {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  driveUrl  String
  notes     String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The technical camera setup for one shot — distinct from StoryboardFrame
// (how it should look) and RundownSegment on the podcast side (this is
// Project's, not Episode's).
model ShotListItem {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description      String
  angle            String?
  lens             String?
  estimatedMinutes Int      @default(5)
  order            Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Production, one row per shoot day. Holds the call sheet's own info
// directly (call time, location, scene schedule, wrap estimate) rather
// than as a separate 1:1 CallSheet model — a call sheet has no existence
// apart from the day it belongs to, unlike ScriptBreakdown/
// StoryboardFrame/ShotListItem, which are genuinely independent ordered
// collections. A Project can have many ShootingDay rows for a
// multi-day shoot (unlike Episode, which assumes a single recording
// session).
model ShootingDay {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduledDate   DateTime?
  callTime        String?
  location        String?
  sceneSchedule   String?
  wrapEstimate    String?
  notes           String?
  order           Int
  continuityNotes ContinuityNote[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Per-take log during a shoot day (slate, take number, whether it was
// good, continuity detail worth remembering for matching later shots) —
// mirrors a script supervisor's paper log. Deliberately append-only:
// create + delete only, no edit endpoint, since a live log is corrected
// by adding/removing entries, not silently rewriting history.
model ContinuityNote {
  id            String      @id @default(cuid())
  shootingDayId String
  shootingDay   ShootingDay @relation(fields: [shootingDayId], references: [id], onDelete: Cascade)
  slate         String?
  takeNumber    Int?
  isGood        Boolean     @default(false)
  notes         String
  createdAt     DateTime    @default(now())
}

// Pasca-Produksi. Each row is one uploaded cut, tagged with which stage
// of the edit pipeline it represents — not one row whose stage gets
// promoted in place, since each new cut is a genuinely new upload (a new
// Google Drive link), matching how editors actually work: Rough Cut,
// Fine Cut, and Picture Lock are distinct files, not one file relabeled.
enum EditVersionStage {
  ROUGH_CUT
  FINE_CUT
  PICTURE_LOCK
}

enum EditApprovalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

model EditVersion {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage          EditVersionStage
  driveUrl       String
  approvalStatus EditApprovalStatus  @default(DRAFT)
  order          Int
  revisionNotes  RevisionNote[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// Reviewer feedback on one EditVersion. `resolved` lets the editor track
// which notes still need addressing without deleting the record of what
// was asked — distinct from ContinuityNote, which is the on-set log, not
// post-production review feedback.
model RevisionNote {
  id            String      @id @default(cuid())
  editVersionId String
  editVersion   EditVersion @relation(fields: [editVersionId], references: [id], onDelete: Cascade)
  content       String
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
}
