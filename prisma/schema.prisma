// Business models are added incrementally as each PRD.md slice is
// implemented (see GitHub issues #2 onward).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma requires at least one model to generate a client. This one exists
// solely so the deploy pipeline (issue #1) has a real migration to run
// and a query to prove connectivity to the dedicated app database — it is
// not a business entity from PRD.md.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

enum WorkspaceMode {
  SOLO
  TIM
}

// Singleton row (id is always 1) — this app has exactly one workspace,
// not multiple tenants, per PRD.md Out of Scope.
model WorkspaceSettings {
  id        Int           @id @default(1)
  mode      WorkspaceMode @default(SOLO)
  updatedAt DateTime      @updatedAt
}

enum ThemeIdeaStatus {
  RAW
  SELECTED
}

model ThemeIdea {
  id          String          @id @default(cuid())
  title       String
  description String?
  tags        String[]        @default([])
  status      ThemeIdeaStatus @default(RAW)
  episodeId   String?         @unique
  episode     Episode?        @relation(fields: [episodeId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum EpisodeStage {
  BANK_TEMA
  RISET_OUTLINE
  PRA_PRODUKSI
  PANDUAN_EKSEKUSI
  PASCA_PRODUKSI
  PUBLISH_DISTRIBUSI
  EVALUASI
}

model Episode {
  id             String          @id @default(cuid())
  title          String
  stage          EpisodeStage    @default(BANK_TEMA)
  themeIdea      ThemeIdea?
  outlineItems   OutlineItem[]
  guestQuestions GuestQuestion[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OutlineItem {
  id           String   @id @default(cuid())
  episodeId    String
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content      String
  referenceUrl String?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuestQuestion {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
