// Business models are added incrementally as each PRD.md slice is
// implemented (see GitHub issues #2 onward).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma requires at least one model to generate a client. This one exists
// solely so the deploy pipeline (issue #1) has a real migration to run
// and a query to prove connectivity to the dedicated app database — it is
// not a business entity from PRD.md.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

enum WorkspaceMode {
  SOLO
  TIM
}

// Singleton row (id is always 1) — this app has exactly one workspace,
// not multiple tenants, per PRD.md Out of Scope.
model WorkspaceSettings {
  id        Int           @id @default(1)
  mode      WorkspaceMode @default(SOLO)
  updatedAt DateTime      @updatedAt
}

enum ThemeIdeaStatus {
  RAW
  SELECTED
}

model ThemeIdea {
  id          String          @id @default(cuid())
  title       String
  description String?
  tags        String[]        @default([])
  status      ThemeIdeaStatus @default(RAW)
  episodeId   String?         @unique
  episode     Episode?        @relation(fields: [episodeId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum EpisodeStage {
  BANK_TEMA
  RISET_OUTLINE
  PRA_PRODUKSI
  PANDUAN_EKSEKUSI
  PASCA_PRODUKSI
  PUBLISH_DISTRIBUSI
  EVALUASI
}

model Episode {
  id                   String            @id @default(cuid())
  title                String
  stage                EpisodeStage      @default(BANK_TEMA)
  recordingScheduledAt DateTime?
  themeIdea            ThemeIdea?
  outlineItems         OutlineItem[]
  guestQuestions       GuestQuestion[]
  checklistItems       ChecklistItem[]
  guests               Guest[]
  rundownSegments      RundownSegment[]
  timestampMarkers     TimestampMarker[]
  showNotesDraft       String?
  showNotesExternalUrl String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model OutlineItem {
  id           String   @id @default(cuid())
  episodeId    String
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content      String
  referenceUrl String?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuestQuestion {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimestampMarker {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  label     String
  timeLabel String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shared by Pra-Produksi, Pasca-Produksi, and Publish & Distribusi checklists
// (distinguished by `category`) per PRD.md Implementation Decisions — one
// reusable model instead of three near-identical tables.
enum ChecklistCategory {
  PRE_PRODUCTION
  POST_PRODUCTION
  PUBLISH
}

model ChecklistItem {
  id        String            @id @default(cuid())
  episodeId String
  episode   Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  category  ChecklistCategory
  label     String
  isDone    Boolean           @default(false)
  order     Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Guest {
  id            String   @id @default(cuid())
  episodeId     String
  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  name          String
  contact       String?
  briefingNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Distinct from OutlineItem: OutlineItem is research/prep material,
// RundownSegment is what actually renders in the full-screen execution
// view (issue #10/#11) — per PRD.md Implementation Decisions, these are
// deliberately separate models even though both are "ordered content
// per episode".
model RundownSegment {
  id               String   @id @default(cuid())
  episodeId        String
  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title            String
  talkingPoints    String
  estimatedMinutes Int      @default(5)
  order            Int
  // Ad-hoc note jotted during a live execution session (e.g. "perlu take
  // ulang di segmen 3") — distinct from talkingPoints, which is prep
  // content authored beforehand.
  sessionNote      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
