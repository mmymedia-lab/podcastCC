# NOTE: do not quote these values. docker/podman --env-file (and compose's
# env_file:) do not strip quotes — they'd become part of the literal value.

# Dedicated app database — separate instance/schema from the existing n8n Postgres on yassalam
DATABASE_URL=postgresql://podcastcc:changeme@db:5432/podcastcc
POSTGRES_PASSWORD=changeme

# Domain Caddy issues HTTPS for (a Tailscale MagicDNS name for private access,
# or a public subdomain if this is later exposed outside the tailnet)
PODCASTCC_DOMAIN=podcastcc.yassalam.ts.net

# Caddy's TLS mode. Leave unset for public domains (automatic Let's Encrypt).
# Set to "internal" for a private domain (e.g. a Tailscale *.ts.net name)
# that can't be verified by public ACME — Caddy then self-signs with its own
# internal CA instead (browsers will warn once until you trust it manually).
PODCASTCC_TLS_MODE=

# Host ports Caddy binds to. Only change these if 80/443 are already taken
# by another service on this host (e.g. a shared reverse proxy) or you're
# deliberately keeping the app off the standard HTTPS port. If you change
# CADDY_HTTPS_PORT from 443, append it to NEXTAUTH_URL below (e.g. :8443).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# NextAuth — generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=https://podcastcc.yassalam.ts.net

# Encrypts per-user Gemini API keys at rest (see lib/crypto.ts). Generate
# with: openssl rand -base64 32 — do not reuse NEXTAUTH_SECRET for this.
# Losing/rotating this key makes any already-stored per-user keys
# undecryptable; those users would need to re-enter their key.
ENCRYPTION_KEY=changeme

# One-time bootstrap admin user (see prisma/seed.ts). Only used if the
# email doesn't already exist — safe to leave set after first deploy.
ADMIN_EMAIL=admin@yassalam.id
ADMIN_PASSWORD=changeme

# Optional — only needed for the AI brainstorming assist (Bank Tema,
# Outline, Show Notes). Leave unset and those buttons just show a clear
# error without blocking manual entry (see PRD.md User Story 30).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional — only needed for auto-creating a Google Drive folder per video
# project (see lib/google-drive.ts). Leave unset and project creation just
# skips the folder (a notice on the Project/Storyboard page says so).
#
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET come from a "Desktop
# app" OAuth client in Google Cloud Console (Credentials page) — not a
# service account, since this org's iam.disableServiceAccountKeyCreation
# policy blocks issuing service-account keys.
#
# GOOGLE_OAUTH_REFRESH_TOKEN is obtained once by running, on your own
# machine (not the server), as the nominated Google account that should
# own the created folders:
#   GOOGLE_OAUTH_CLIENT_ID=... GOOGLE_OAUTH_CLIENT_SECRET=... node scripts/get-google-drive-refresh-token.mjs
#
# GOOGLE_DRIVE_SHARED_DRIVE_ID is the existing Shared Drive's ID (from its
# Drive URL: drive.google.com/drive/folders/<this-id>).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
